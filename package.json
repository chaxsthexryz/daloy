{
  "name": "daloy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "demo:site": "pnpm --filter @daloy/web build:site",
    "seed": "pnpm --filter @daloy/api exec tsx src/seed.ts",
    "reliability:load": "pnpm --filter @daloy/worker exec tsx reliability/load.ts",
    "reliability:chaos": "pnpm --filter @daloy/worker exec tsx reliability/chaos.ts"
  },
  "devDependencies": {
    "@daloy/db": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "^10.14.0",
    "pg": "^8.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
