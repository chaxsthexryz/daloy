# Copy to .env. Compose refuses to start until SECRETS_KEY and both database passwords are set.
POSTGRES_USER=daloy
# Owner role password. Generate with: openssl rand -hex 24
# Postgres reads both passwords only when its volume is first created; changing them later needs ALTER ROLE as well.
POSTGRES_PASSWORD=
POSTGRES_DB=daloy
# Password of daloy_app, the DML-only role the api and worker use in compose. Generate with: openssl rand -hex 24
APP_DB_PASSWORD=
# For running the apps outside Docker against the compose database. Use the POSTGRES_PASSWORD above.
DATABASE_URL=postgres://daloy:<POSTGRES_PASSWORD>@localhost:5432/daloy

# Mailpit
# Mailpit catches all mail by default (http://localhost:8025). In Docker the host is "mailpit";
# use localhost when the worker runs outside Docker.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Daloy <daloy@localhost>
# This is the installation's own server, used by every account that has not connected Gmail. Leave it on Mailpit.
# To send real email from Gmail, connect it per account in the console under "Business and email" (README, Send real email).
# Pointing SMTP_* at a personal Gmail account here would make every account on this installation send as that address.
# Who may send through this shared server (decision 0024): open (anyone) or approved (only workspace owners the
# operator approved, see README "Send real email"). Empty: open while SMTP_HOST is Mailpit or localhost, approved
# for any other server. Set approved before opening sign-up to people outside your team.
SHARED_MAIL=

# AI step. Ollama on the host by default. From inside Docker the host is host.docker.internal;
# use http://localhost:11434 when you run the worker outside Docker.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.2
# Any OpenAI-compatible API instead, for example the Gemini API free tier (key from Google AI Studio):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=<a model id from the Gemini API model list>
#   LLM_API_KEY=<your key>
# Or DeepSeek (paid per token; key from platform.deepseek.com). Daloy turns DeepSeek's thinking off, since its AI
# jobs are short labels, summaries and drafts:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-flash
#   LLM_API_KEY=<your key>
# Or a local llama.cpp server, such as the one the Hermes agent desktop app runs (its port, model alias and the
# value of its --api-key flag):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://host.docker.internal:18434/v1
#   LLM_MODEL=Qwen3.5-4B-Q4_K_M
#   LLM_API_KEY=<the server's --api-key>
# Trigger data (form messages, names, emails) is sent to that provider. Free tiers may use it to improve their models.
LLM_API_KEY=
# Set to on only when the local model reads images (JPEG, PNG, WebP). Hosted providers are handled by Daloy.
LLM_VISION=
# Whether accounts may use LLM_API_KEY (decision 0035). off: the key is never sent for an account, and each account
# saves its own key under "AI model". open: accounts without a saved key, and the "Local model" choice, send it.
# Use open only when every account on this installation is yours.
SHARED_LLM_KEY=off

# Optional: UniSMS Philippine SMS gateway fallback (decision 0068).
# When SHARED_UNISMS_KEY=open with both values below set, paid workspaces (pilot, business, business_plus) without their
# own UniSMS connection can send SMS within their monthly quota. Preview workspaces have sms: 0 and never spend operator credits.
UNISMS_SECRET_KEY=
UNISMS_SENDER_ID=
SHARED_UNISMS_KEY=off

# Where the API is reachable from a browser. Approval emails link to <PUBLIC_URL>/approvals/<token>, and the Gmail
# confirmation email to <PUBLIC_URL>/#/verify-sender/<token>.
PUBLIC_URL=http://localhost:3000

# Optional: Connect Outlook (roadmap phase 5, decision 0023). Register a free Microsoft Entra app with the redirect URI
# <PUBLIC_URL>/settings/connections/outlook/callback and the delegated Graph permissions Mail.Send, User.Read and
# offline_access, then paste its client id and a client secret. Leave empty to hide Outlook. MICROSOFT_TENANT is
# "organizations" (any work or school account) or your tenant id. Teams needs no setting here.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=organizations

# Managed OAuth ("Connect <App>", decision 0058). One OAuth app per provider per environment: never share a client
# between development and production. Redirect URI for every provider: <PUBLIC_URL>/settings/connections/oauth/callback.
# An app without a client keeps its paste form. Set OAUTH_ENV (development or production) once any client below is set;
# it must match PUBLIC_URL (development only on localhost), or the API and the worker refuse to start.
# OAUTH_ENV=development
# Google Sheets and Drive (decision 0060): an OAuth client of type Web application, scopes openid, email and drive.file.
# The Picker also needs a browser API key restricted to your site (public) and the Cloud project number (public, the
# Picker's app id). Without them Create a sheet or folder still works, and Pick is refused.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_PICKER_API_KEY=
# GOOGLE_PROJECT_NUMBER=
# Gmail (decision 0063) uses the same client: add the gmail.send scope to the consent screen and turn on the Gmail API.
# Gmail is a sensitive scope: up to 100 test users until Google reviews it (docs/live-gmail-oauth-check.md).
# Slack ("Connect Slack", decision 0061): create a Slack app with the bot scopes chat:write and channels:read, token
# rotation off, and the redirect URL above. Both values are needed, or the card keeps the pasted bot token form.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Airtable: register data.records:write and schema.bases:read.
# AIRTABLE_CLIENT_ID=
# AIRTABLE_CLIENT_SECRET=
# Notion: a public integration with Read content and Insert content; no user email capability.
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# Trello: a confidential OAuth 2.0 client with read:member:trello, read:board:trello and write:board:trello.
# Daloy also asks for offline_access so the connection can refresh.
# TRELLO_CLIENT_ID=
# TRELLO_CLIENT_SECRET=

# Deployment (docs/deployment.md). Number of proxies in front of the API, so rate limits key on the real client:
# 1 behind cloudflared or Caddy, 0 when the browser talks to port 3000 directly.
TRUST_PROXY=0
# true when the console is served over HTTPS, so the session cookie is marked Secure. NODE_ENV=production also turns it on.
SECURE_COOKIES=false
# Sign-ups per client IP per hour.
REGISTER_LIMIT_PER_HOUR=10
# Plan a new sign-up starts on. Empty: "preview" (one live automation, hourly schedules at most, small daily limits, no shared AI key).
# none: no plan, so no limits, for a private installation where everyone who can sign up is trusted.
SIGNUP_PLAN=
# Comma list of the only hosts an HTTP step may call, each exact or "*.example.com" for subdomains. Empty: any public host.
# Set it on a public demo, for example HTTP_ALLOWED_HOSTS=httpbin.org,*.example.com
HTTP_ALLOWED_HOSTS=

# 32 random bytes, base64. Encrypts stored secrets. Generate with: openssl rand -base64 32
SECRETS_KEY=
PORT=3000

# Recipients a workspace may send to in one Manila day through its own Gmail or Outlook (decision 0052). Over it, the run waits for a person and nothing is sent. Default 400.
MAILBOX_DAILY_CAP=
# Days to keep retired secret values for read-side redaction before scrubbing stored history and deleting them. Positive integer, default 90.
RETIRED_SECRETS_MAX_AGE_DAYS=

# on turns on "Ask about a request" in Build with AI (decision 0041). Keep off until docs/ai-ask-measurement.md is done.
AI_ASK=off
