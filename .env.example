# Copy to .env. These are local development values only.
POSTGRES_USER=daloy
POSTGRES_PASSWORD=daloy
POSTGRES_DB=daloy
# Password of daloy_app, the DML-only role the api and worker use in compose.
APP_DB_PASSWORD=daloy_app
DATABASE_URL=postgres://daloy:daloy@localhost:5432/daloy

# Mailpit
# Mailpit catches all mail by default (http://localhost:8025). In Docker the host is "mailpit";
# use localhost when the worker runs outside Docker.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Daloy <daloy@localhost>
# To send real email from Gmail: turn on 2-Step Verification, create an app password
# (Google Account, Security, App passwords), then set:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=<your Gmail address>
#   SMTP_PASS=<the 16-character app password>
#   SMTP_FROM=<your Gmail address>
# and restart the worker. Real mail then goes to real inboxes, including test runs with "Make live calls" ticked.

# AI step. Ollama on the host by default. From inside Docker the host is host.docker.internal;
# use http://localhost:11434 when you run the worker outside Docker.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.2
# Any OpenAI-compatible API instead, for example the Gemini API free tier (key from Google AI Studio):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=<a model id from the Gemini API model list>
#   LLM_API_KEY=<your key>
# Or a local llama.cpp server, such as the one the Hermes agent desktop app runs (its port, model alias and the
# value of its --api-key flag):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://host.docker.internal:18434/v1
#   LLM_MODEL=Qwen3.5-4B-Q4_K_M
#   LLM_API_KEY=<the server's --api-key>
# Trigger data (form messages, names, emails) is sent to that provider. Free tiers may use it to improve their models.
LLM_API_KEY=

# Where the API is reachable from a browser. Approval emails link to <PUBLIC_URL>/approvals/<token>.
PUBLIC_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts stored secrets. Generate with: openssl rand -base64 32
SECRETS_KEY=
PORT=3000
